{
    "name": "forumify/forumify-dossier-theme",
    "description": "A classified field file: stencilled headings, typewritten pages, rubber stamps and classification banners.",
    "type": "forumify-theme",
    "license": "OSL-3.0",
    "require": {
        "php": ">=8.4",
        "forumify/forumify-platform": "^1.3",
        "forumify/forumify-theme": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-symfony": "^2.0",
        "slevomat/coding-standard": "^8.15",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {
        "psr-4": {
            "Forumify\\DossierTheme\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": false,
            "symfony/runtime": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "lock": false
    },
    "extra": {
        "forumify-plugin-class": "Forumify\\DossierTheme\\DossierTheme"
    },
    "homepage": "https://forumify.net"
}
